# File: ui-shells/domain-shells/compliance-shell/Dockerfile.dev
# syntax=docker/dockerfile:1.7
FROM base-image:local
ARG SERVICE_PATH=/app/ui-shells/domain-shells/compliance-shell

ARG VITE_ORIGIN=http://localhost:3020
ARG PDF_REMOTE_ENTRY=http://localhost:4011/pdf/client/remoteEntry.js
ARG PDF_API_URL=http://pdf-server:4001
ARG ESIGN_REMOTE_ENTRY=http://localhost:4012/esign/client/remoteEntry.js
ARG ESIGN_API_URL=http://esign-server:4002
ARG COMPLIANCE_REMOTE_ENTRY=http://localhost:3021/compliance/client/remoteEntry.js
ARG ARG COMPLIANCE_API_URL=http://compliance-server:8082
ARG TOPOLOGY_REMOTE_ENTRY=http://localhost:3011/topology/client/remoteEntry.js
ARG TOPOLOGY_API_URL=http://topology-server:8083

ENV VITE_ORIGIN=${VITE_ORIGIN} \
	COMPLIANCE_REMOTE_ENTRY=${COMPLIANCE_REMOTE_ENTRY} \
	TOPOLOGY_REMOTE_ENTRY=${TOPOLOGY_REMOTE_ENTRY} \
	PDF_REMOTE_ENTRY=${PDF_REMOTE_ENTRY} \
	ESIGN_REMOTE_ENTRY=${ESIGN_REMOTE_ENTRY}
WORKDIR /app
RUN mkdir -p "${SERVICE_PATH}/src"


COPY package.json tsconfig.json ${SERVICE_PATH}/
RUN --mount=type=cache,id=distributed-platform-pnpm,target=/root/.local/share/pnpm/store \
	pnpm install --frozen-lockfile --ignore-scripts
COPY vite.config.ts index.html ${SERVICE_PATH}/
COPY src/ ${SERVICE_PATH}/src/
RUN pnpm build

WORKDIR ${SERVICE_PATH}
RUN chown -R node:node "${SERVICE_PATH}"
USER node
EXPOSE 3020

CMD ["pnpm", "dev"]