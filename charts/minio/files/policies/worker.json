{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::dsap/compliance/drafts/*",
        "arn:aws:s3:::dsap/compliance/transfers/*",
        "arn:aws:s3:::dsap/audit/transfers/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::dsap"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["compliance/drafts/*", "compliance/transfers/*", "audit/transfers/*"]
        }
      }
    }
  ]
}
