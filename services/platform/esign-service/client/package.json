{
  "name": "esign-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "test": "pnpm test:unit && pnpm test:contract",
    "test:unit": "vitest run .unit.test",
    "test:contract": "vitest run .contract.test",
    "test:integration": "vitest run .integration.test"
  },
  "peerDependencies": {
    "react": "~19.2.8",
    "react-dom": "~19.2.8"
  },
  "dependencies": {
    "@contracts/esign": "workspace:*"
  },
  "devDependencies": {
    "@shared/ui-components": "workspace:*"
  }
}