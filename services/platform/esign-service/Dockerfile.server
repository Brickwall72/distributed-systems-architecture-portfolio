# syntax=docker/dockerfile:1.7
# File: services/platform/esign-service/Dockerfile.server

# --- STAGE 1: Builder ---
FROM base-image:local AS builder
ARG SERVICE_PATH=/app/services/platform/esign-service/server
WORKDIR /app

# Just copy the service source code directly into the workspace structure already established by the base image
COPY server/ ${SERVICE_PATH}/

WORKDIR ${SERVICE_PATH}
# The workspace is already linked from the base image; just build directly
RUN pnpm build

# --- STAGE 2: Dev Target ---
FROM builder AS dev
# Run as root: eliminates the slow chown layer and bypasses volume mount permission issues
ARG SERVICE_PATH=/app/services/platform/esign-service/server
WORKDIR ${SERVICE_PATH}
EXPOSE 8080
CMD ["pnpm", "dev"]

# --- STAGE 3: Static / Prod Target ---
FROM node:26.7.0-alpine AS prod
ARG SERVICE_PATH=/app/services/platform/esign-service/server

ENV NODE_ENV=production

WORKDIR /app

# Use --chown during COPY to avoid duplicating file layers just to change ownership
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/packages ./packages
COPY --chown=node:node --from=builder /app/pnpm-lock.yaml ./

WORKDIR ${SERVICE_PATH}

# Copy the compiled distribution files, package manifest, and production dependencies securely
COPY --chown=node:node --from=builder ${SERVICE_PATH}/dist ./dist
COPY --chown=node:node --from=builder ${SERVICE_PATH}/package.json ./
COPY --chown=node:node --from=builder ${SERVICE_PATH}/node_modules ./node_modules

# Enforce least-privilege security
USER node
EXPOSE 8080

CMD ["node", "dist/server.js"]