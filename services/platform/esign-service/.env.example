# File: services/platform/esign-service/.env
SIGNING_CERT_PATH=./certs/certificate.p12
SIGNING_CERT_PASSWORD=changeit

# MinIO / S3 Configuration
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=local-esign
S3_SECRET_KEY=local-esign-password
S3_BUCKET=dsap