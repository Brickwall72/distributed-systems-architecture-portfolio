{
  "name": "@portfolio/pdf-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=26.7.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./widget": "./dist/widget/index.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:file": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "express": "^5.0.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
