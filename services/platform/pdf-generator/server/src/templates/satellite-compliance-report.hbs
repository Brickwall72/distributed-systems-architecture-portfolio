<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Orbital Compliance Report</title>
  <style>
    body { font-family: 'Helvetica Neue', Arial, sans-serif; margin: 40px; color: #1e293b; }
    .header { border-b: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 24px; }
    .title { font-size: 24px; font-weight: bold; color: #0f172a; text-transform: uppercase; }
    .meta { font-size: 12px; color: #64748b; margin-top: 4px; }
    .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase; }
    .badge-pass { background-color: #dcfce7; color: #166534; }
    .badge-fail { background-color: #fee2e2; color: #991b1b; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th { background-color: #f8fafc; text-align: left; padding: 10px; font-size: 11px; text-transform: uppercase; color: #475569; border-bottom: 1px solid #e2e8f0; }
    td { padding: 10px; border-bottom: 1px solid #e2e8f0; font-size: 13px; }
    .footer { margin-top: 40px; text-align: center; font-size: 10px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 12px; }
  </style>
</head>
<body>
  <div class="header">
    <div class="title">LEO Constellation Compliance Audit</div>
    <div class="meta">Generated: {{timestamp}} | Constellation Mesh: <strong>{{constellationName}}</strong></div>
  </div>

  <h3>Satellite Node Status Summary</h3>
  <table>
    <thead>
      <tr>
        <th>Satellite ID</th>
        <th>Orbital Altitude</th>
        <th>Downlink Status</th>
        <th>Encryption Layer</th>
      </tr>
    </thead>
    <tbody>
      {{#each satellites}}
      <tr>
        <td><strong>{{this.satId}}</strong></td>
        <td>{{this.altitudeKm}} km</td>
        <td>
          <span class="badge {{#if this.isOperational}}badge-pass{{else}}badge-fail{{/if}}">
            {{#if this.isOperational}}Operational{{else}}Degraded{{/if}}
          </span>
        </td>
        <td>{{this.encryptionProtocol}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="footer">
    UNCLASSIFIED // System-Generated Report via Fleet Compliance Engine
  </div>
</body>
</html>