# File: services/platform/auth-service/.env.example
NODE_ENV=development
# Dev login mints a token for any seeded identity on request. Enable only for demos.
AUTH_DEV_LOGIN=true
# Local dev: either point at a key file or inline the PEM with \n escapes.
# Generate keys with scripts/generate-auth-keys.sh (writes .auth-keys/).
AUTH_PRIVATE_KEY_FILE=../../../.auth-keys/private.pem
AUTH_TOKEN_TTL_SECONDS=900
