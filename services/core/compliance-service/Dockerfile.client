# syntax=docker/dockerfile:1.7
# File: services/core/compliance-service/Dockerfile.client

# --- STAGE 1: Builder ---
FROM base-image:local AS builder
ARG SERVICE_PATH=/app/services/core/compliance-service/client
WORKDIR /app

# Full context copy replaces file whitelisting. 
# .dockerignore handles ignoring local node_modules/ and dist/
COPY client/ ${SERVICE_PATH}/

RUN --mount=type=cache,id=distributed-platform-pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts

WORKDIR ${SERVICE_PATH}
RUN pnpm build

# --- STAGE 2: Dev Target ---
FROM builder AS dev
ARG SERVICE_PATH=/app/services/core/compliance-service/client
WORKDIR ${SERVICE_PATH}

# DevSecOps Fix: Ensure 'node' user owns node_modules for Vite cache creation (.vite-temp)
RUN chown -R node:node "${SERVICE_PATH}"

USER node
EXPOSE 3000

CMD ["pnpm", "dev"]

# --- STAGE 3: Static / Prod Target ---
FROM nginxinc/nginx-unprivileged:alpine AS prod
ARG SERVICE_PATH=/app/services/core/compliance-service/client

USER root

RUN rm -rf /usr/share/nginx/html/* && \
    rm /etc/nginx/conf.d/default.conf

COPY client/nginx.conf /etc/nginx/conf.d/default.conf

# Configure runtime permissions for unprivileged Nginx execution
RUN chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && chown -R nginx:nginx /etc/nginx/conf.d \
    && touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/run/nginx.pid

# Securely copy compiled static assets from the builder stage
COPY --from=builder ${SERVICE_PATH}/dist /usr/share/nginx/html

USER nginx
EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]