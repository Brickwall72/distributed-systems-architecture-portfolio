<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Asset Transfer Authorization</title>
  <style>
    html {
      height: 100%;
    }
    html, body {
      margin: 0;
      background-color: #ffffff;
    }
    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: #333;
      padding: 32px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 100%;
    }
    .doc-content {
      flex: 1;
    }
    .header-title {
      text-align: center;
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 20px;
      text-transform: uppercase;
    }
    .form-grid {
      display: table;
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .grid-row {
      display: table-row;
    }
    .grid-cell {
      display: table-cell;
      border: 1px solid #000;
      padding: 8px;
      vertical-align: top;
      width: 50%;
    }
    .label {
      font-size: 10px;
      font-weight: bold;
      text-transform: uppercase;
      display: block;
      margin-bottom: 4px;
    }
    .table-items {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .table-items th, .table-items td {
      border: 1px solid #000;
      padding: 8px;
      text-align: left;
    }
    .table-items th {
      font-size: 10px;
      background-color: #f3f4f6;
    }
    .signature-block {
      border: 1px solid #000;
      padding: 15px;
      box-sizing: border-box;
      margin-top: auto;
    }
    .sig-line {
      border-bottom: 1px solid #000;
      width: 250px;
      display: inline-block;
      margin-left: 10px;
    }
  </style>
</head>
<body>
  <div class="doc-content">
    <div class="header-title">
      Asset Transfer Authorization Form<br>
      (Initiating Document)
    </div>
    
    <div class="form-grid">
      <div class="grid-row">
        <div class="grid-cell">
          <span class="label">1. From (Releasing Entity / Authorizing):</span>
          <strong>{{authorizingEntityName}}</strong><br>
          {{authorizingAddressLine1}}<br>
          {{authorizingAddressLine2}}
        </div>
        <div class="grid-cell">
          <span class="label">2. To (Receiving Entity / Destination):</span>
          <strong>{{receivingEntityName}}</strong><br>
          {{receivingAddressLine1}}<br>
          {{receivingAddressLine2}}
        </div>
      </div>
      <div class="grid-row">
        <div class="grid-cell">
          <span class="label">3. Authority / Requisition Number:</span>
          {{requisitionNumber}}
        </div>
        <div class="grid-cell">
          <span class="label">4. Date of Transfer Authorization (YYYYMMDD):</span>
          {{authorizationDate}}
        </div>
      </div>
    </div>

    <table class="table-items">
      <thead>
        <tr>
          <th>Item No.</th>
          <th>Asset Description &amp; Serial Number</th>
          <th>Unit of Issue</th>
          <th>Quantity</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>{{this.itemNumber}}</td>
          <td>
            <strong>{{this.nomenclature}}</strong><br>
            S/N: {{this.serialNumber}}<br>
            <em>{{this.additionalNotes}}</em>
          </td>
          <td>{{this.unit}}</td>
          <td>{{this.quantity}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="signature-block">
    <span class="label">Release Authorization</span>
    <p>I certify that the release and transfer of the assets listed above is authorized.</p>
    <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <strong>Authorizing Official:</strong> 
        <span class="sig-line"></span>
      </div>
      <div>
        <strong>Date:</strong> <span class="sig-line" style="width: 150px; display: inline-block;"></span>
      </div>
    </div>
  </div>
</body>
</html>