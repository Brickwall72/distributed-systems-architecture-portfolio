{
  "name": "compliance-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && pnpm copy-assets",
    "copy-assets": "node -e \"fs.cpSync('src/assets/templates', 'dist/assets/templates', { recursive: true })\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:verify",
    "test:unit": "vitest run .unit.test",
    "test:integration": "vitest run .integration.test",
    "test:contract": "vitest run .contract.test",
    "test:verify": "vitest run .provider.contract.spec"
  },
  "peerDependencies": {
    "@contracts/common": "workspace:*"
  },
  "dependencies": {
    "@shared/ui-components": "workspace:*",
    "@shared/express": "workspace:*",
    "@shared/messaging": "workspace:*",
    "@shared/filestore": "workspace:*",
    "@contracts/esign": "workspace:*",
    "@contracts/compliance": "workspace:*",
    "@contracts/pdf": "workspace:*",
    "compliance-shared": "workspace:*",
    "@nats-io/jetstream": "~3.4.0",
    "@nats-io/transport-node": "~3.4.0",
    "@ts-rest/core": "~3.52.1",
    "@ts-rest/express": "~3.52.1",
    "express": "^4.0.0",
    "pg": "~8.23.0",
    "zod": "~3.24.1"
  }
}
