{
  "name": "audit-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && node -e \"fs.cpSync('src/registry/templates', 'dist/registry/templates', { recursive: true })\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "pnpm test:unit && pnpm test:verify",
    "test:unit": "vitest run .unit.test",
    "test:verify": "vitest run .provider.contract.spec"
  },
  "peerDependencies": {},
  "dependencies": {
    "@contracts/common": "workspace:*",
    "@contracts/compliance": "workspace:*",
    "@contracts/topology": "workspace:*",
    "@contracts/pdf": "workspace:*",
    "@shared/express": "workspace:*",
    "@shared/filestore": "workspace:*",
    "@shared/messaging": "workspace:*",
    "@ts-rest/core": "~3.52.1",
    "@ts-rest/express": "~3.52.1",
    "audit-shared": "workspace:*",
    "express": "^4.0.0",
    "handlebars": "~4.7.9",
    "mongodb": "~7.8.0",
    "zod": "~3.24.1"
  },
  "devDependencies": {
    "@shared/testing": "workspace:*"
  }
}
