{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.unit.test.ts", "vitest.config.ts"],
      "outputs": []
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.contract.test.ts"],
      "outputs": ["pacts/**", "**/pacts/**"]
    },
    "test:verify": {
      "dependsOn": ["^test:contract", "test:contract"],
      "inputs": ["src/**/*.ts", "src/**/*.contract.verify.test.ts", "pacts/**", "**/pacts/**"],
      "outputs": []
    }
  }
}