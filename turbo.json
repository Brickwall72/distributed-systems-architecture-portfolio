{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json", "tsup.config.ts", "package.json"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.unit.test.ts",
        "src/**/*.unit.test.tsx",
        "dist/**",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": ["GRAPH_TEST_NEO4J_URI"],
      "cache": false
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.contract.test.ts", "src/**/*.contract.test.tsx"],
      "outputs": ["pacts/**", "**/pacts/**"]
    },
    "test:verify": {
      "dependsOn": ["^test:contract", "test:contract"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.contract.verify.test.ts", "src/**/*.contract.verify.test.tsx", "pacts/**", "**/pacts/**"],
      "outputs": []
    }
  }
}