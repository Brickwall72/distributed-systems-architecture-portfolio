{
  "name": "distributed-systems-architecture-portfolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "services:build": "pnpm --filter \"./services/**\" --filter \"./packages/**\" build",
    "services:test": "pnpm --filter \"./services/**\" --filter \"./packages/**\" test",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "storybook": "NODE_OPTIONS='--no-deprecation' storybook dev -p 6006",
    "docker:base": "docker build -f Dockerfile.base -t base-image:local ."
  },
  "devDependencies": {
    "@module-federation/vite": "~1.21.2",
    "@shared/tsconfig": "workspace:*",
    "@storybook/addon-links": "~10.6.0",
    "@storybook/react": "~10.6.0",
    "@storybook/react-vite": "~10.6.0",
    "@tailwindcss/vite": "~4.3.3",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@types/cors": "~2.8.19",
    "@types/express": "~5.0.6",
    "@types/node": "~26.2.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/supertest": "~6.0.3",
    "@vitejs/plugin-react": "~6.1.1",
    "happy-dom": "~20.11.15",
    "msw": "~2.15.0",
    "msw-storybook-addon": "~3.0.0",
    "storybook": "~10.6.0",
    "supertest": "~7.2.2",
    "tailwindcss": "~4.3.3",
    "typescript": "~7.0.2",
    "vite": "~8.2.2",
    "vitest": "~4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}